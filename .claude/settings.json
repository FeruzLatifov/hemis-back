{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(gradle:*)",
      "WebSearch",
      "WebFetch(domain:mvnrepository.com)",
      "WebFetch(domain:docs.spring.io)",
      "WebFetch(domain:docs.sentry.io)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(docker run:*)"
    ]
  },
  "env": {
    "TESTS_ENABLED": "true"
  },
  "companyAnnouncements": [
    "Remember: all endpoints must have Swagger documentation and tests.",
    "Use Liquibase migrations instead of direct SQL changes.",
    "Do not modify legacy tables in ministry.sql without approval."
  ]
}
